# Copy to .env for local runs. "docker compose up" reads this file automatically.
# Placeholder values only - real secrets go in .env, never in code.

# Postgres for non-Docker runs. Inside docker compose the app container gets its
# own DATABASE_URL pointing at the db service.
DATABASE_URL=postgres://contract_guard:contract_guard@localhost:5432/contract_guard

# Where publish webhook alerts are sent (the starter-kit's webhook receiver).
WEBHOOK_URL=http://localhost:9099/webhook

# Session signing key and the seeded demo user's password.
SESSION_SECRET=replace-with-a-long-random-string
DEMO_PASSWORD=replace-before-the-demo
