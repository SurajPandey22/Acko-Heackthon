{
  "name": "acko-contract-guard",
  "version": "0.1.0",
  "description": "API contract registry that catches breaking OpenAPI changes before they reach consumers",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:acceptance": "vitest run tests/acceptance",
    "lint": "biome check .",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "connect-pg-simple": "^10.0.0",
    "drizzle-orm": "^0.45.4",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@electric-sql/pglite": "^0.5.16",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
